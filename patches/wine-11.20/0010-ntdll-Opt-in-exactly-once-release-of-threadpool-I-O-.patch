-static void CALLBACK ioqueue_thread_proc( void *param )
+
+/* The fixed I/O completion accounting below is opt-in: CALIMOCHO_FIX_THREADPOOL_IO=1.
+ * Without it the original code paths run unchanged. Read once. */
+static BOOL tp_io_fix_enabled(void)
+{
+    static int enabled = -1;
+
+    if (enabled < 0)
+    {
+        WCHAR buffer[2];
+        UNICODE_STRING name = RTL_CONSTANT_STRING( L"CALIMOCHO_FIX_THREADPOOL_IO" ), value;
+
+        value.Buffer = buffer;
+        value.Length = 0;
+        value.MaximumLength = sizeof(buffer);
+        enabled = !RtlQueryEnvironmentVariable_U( NULL, &name, &value ) &&
+                  value.Length == sizeof(WCHAR) && buffer[0] == '1';
+    }
+    return enabled;
+}
+
+/* ioqueue.cs must be taken before pool->cs. The completion thread and
+ * TpReleaseIoCompletion() both observe a finished object and would otherwise
+ * each drop it. */
+
+static struct threadpool_object *tp_ioqueue_find( ULONG_PTR key )
+{
+    struct list *ptr;
+
+    LIST_FOR_EACH( ptr, &ioqueue.objs )
+    {
+        struct threadpool_object *io = LIST_ENTRY( ptr, struct threadpool_object, u.io.ioqueue_entry );
+
+        if ((ULONG_PTR)io == key)
+            return io;
+    }
+    return NULL;
+}
+
+static void tp_ioqueue_unlist( struct threadpool_object *io )
+{
+    if (!io->u.io.on_queue)
+        return;
+    list_remove( &io->u.io.ioqueue_entry );
+    io->u.io.on_queue = FALSE;
+}
+
+static void tp_ioqueue_drop_count( struct threadpool_object *io )
+{
+    if (io->u.io.detached)
+        return;
+    io->u.io.detached = TRUE;
+    assert( ioqueue.objcount );
+    if (!--ioqueue.objcount)
+        NtSetIoCompletion( ioqueue.port, 0, 0, STATUS_SUCCESS, 0 );
+}
+
+/* Caller holds ioqueue.cs and pool->cs. Returns TRUE when this caller owns
+ * the object's initial reference and must release it. */
+static BOOL tp_io_claim_release( struct threadpool_object *io )
+{
+    if (io->shutdown || !io->u.io.shutting_down)
+        return FALSE;
+    if (io->u.io.pending_count || io->u.io.skipped_count)
+        return FALSE;
+
+    io->shutdown = TRUE;
+    tp_ioqueue_unlist( io );
+    tp_ioqueue_drop_count( io );
+    return TRUE;
+}
+
+static void ioqueue_thread_proc_legacy( void *param )
 {
     struct io_completion *completion;
     struct threadpool_object *io;
@@ -1702,6 +1779,105 @@ static void CALLBACK ioqueue_thread_proc( void *param )
     RtlExitUserThread( 0 );
 }
 
+static void ioqueue_thread_proc_fixed( void *param )
+{
+    struct io_completion *completion;
+    struct threadpool_object *io;
+    IO_STATUS_BLOCK iosb;
+    ULONG_PTR key, value;
+    BOOL release;
+    NTSTATUS status;
+
+    TRACE( "starting I/O completion thread\n" );
+    set_thread_name(L"wine_threadpool_ioqueue");
+
+    RtlEnterCriticalSection( &ioqueue.cs );
+
+    for (;;)
+    {
+        RtlLeaveCriticalSection( &ioqueue.cs );
+        if ((status = NtRemoveIoCompletion( ioqueue.port, &key, &value, &iosb, NULL )))
+            ERR("NtRemoveIoCompletion failed, status %#lx.\n", status);
+        RtlEnterCriticalSection( &ioqueue.cs );
+
+        release = FALSE;
+        io = key ? tp_ioqueue_find( key ) : NULL;
+
+        TRACE( "io %p, iosb.Status %#lx.\n", io, iosb.Status );
+
+        if (io)
+        {
+            RtlEnterCriticalSection( &io->pool->cs );
+
+            TRACE( "pending_count %u.\n", io->u.io.pending_count );
+
+            if (io->u.io.shutting_down && !io->u.io.pending_count)
+            {
+                /* A cancelled wait still expects this many completions and
+                 * must not run the callback for them. */
+                if (io->u.io.skipped_count)
+                    --io->u.io.skipped_count;
+            }
+            else if (io->u.io.pending_count)
+            {
+                --io->u.io.pending_count;
+                if (!array_reserve((void **)&io->u.io.completions, &io->u.io.completion_max,
+                        io->u.io.completion_count + 1, sizeof(*io->u.io.completions)))
+                {
+                    ERR( "Failed to allocate memory.\n" );
+                    RtlLeaveCriticalSection( &io->pool->cs );
+                    continue;
+                }
+
+                completion = &io->u.io.completions[io->u.io.completion_count++];
+                completion->iosb = iosb;
+                completion->cvalue = value;
+
+                tp_object_submit( io, FALSE );
+            }
+
+            /* The completion that finishes the last expected operation has
+             * to release the object. TpReleaseIoCompletion() did not, because
+             * the counts were not zero yet. */
+            if (io->u.io.shutting_down && !io->shutdown && !io->u.io.pending_count && !io->u.io.skipped_count)
+                release = tp_io_claim_release( io );
+
+            RtlLeaveCriticalSection( &io->pool->cs );
+
+            if (release)
+            {
+                RtlLeaveCriticalSection( &ioqueue.cs );
+                tp_object_release( io );
+                RtlEnterCriticalSection( &ioqueue.cs );
+            }
+        }
+
+        if (!ioqueue.objcount)
+        {
+            /* All I/O objects have been destroyed; if no new objects are
+             * created within some amount of time, then we can shutdown this
+             * thread. */
+            LARGE_INTEGER timeout = {.QuadPart = (ULONGLONG)THREADPOOL_WORKER_TIMEOUT * -10000};
+            if (RtlSleepConditionVariableCS( &ioqueue.update_event, &ioqueue.cs,
+                    &timeout) == STATUS_TIMEOUT && !ioqueue.objcount)
+                break;
+        }
+    }
+
+    ioqueue.thread_running = FALSE;
+    RtlLeaveCriticalSection( &ioqueue.cs );
+
+    TRACE( "terminating I/O completion thread\n" );
+
+    RtlExitUserThread( 0 );
+}
+
+static void CALLBACK ioqueue_thread_proc( void *param )
+{
+    if (tp_io_fix_enabled()) ioqueue_thread_proc_fixed( param );
+    else ioqueue_thread_proc_legacy( param );
+}
