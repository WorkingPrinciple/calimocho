+static void tp_release_io_completion_fixed( struct threadpool_object *this )
+{
+    BOOL release;
+
+    /* Same lock order as ioqueue_thread_proc(). */
+    RtlEnterCriticalSection( &ioqueue.cs );
+    RtlEnterCriticalSection( &this->pool->cs );
+
+    this->u.io.shutting_down = TRUE;
+    release = tp_io_claim_release( this );
+
+    RtlLeaveCriticalSection( &this->pool->cs );
+    RtlLeaveCriticalSection( &ioqueue.cs );
+
+    if (release)
+        tp_object_release( this );
+}
+
+void WINAPI TpReleaseIoCompletion( TP_IO *io )
+{
+    struct threadpool_object *this = impl_from_TP_IO( io );
+
+    TRACE( "%p\n", io );
+
+    if (tp_io_fix_enabled()) tp_release_io_completion_fixed( this );
+    else tp_release_io_completion_legacy( this );
+}
