+static LSTATUS WINAPI my_RegOpenKeyExA(HKEY p1, LPCSTR p2, DWORD p3, DWORD p4, HKEY* p5)
+{
+    LSTATUS result;
+    void *ret_ptr;
+    ULONG ret_len;
+    struct regcreateopenkeyexa_params params =
+    {
+        .dispatch = {.callback = regcreateopenkeyexa_callback},
+        .create = 0,
+        .hkey = HandleToUlong(p1),
+        .name = (UINT_PTR)p2,
+        .options = p3,
+        .access = p4,
