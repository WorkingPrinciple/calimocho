+static HRESULT json_array_reserve( struct json_array *impl, UINT32 length )
+{
+    UINT32 capacity;
+    IJsonValue **new;
+
+    if (length <= impl->capacity) return S_OK;
+    capacity = max( length, max( 32, impl->capacity * 3 / 2 ) );
+    if (!(new = realloc( impl->elements, capacity * sizeof(*new) ))) return E_OUTOFMEMORY;
+    impl->elements = new;
+    impl->capacity = capacity;
+    return S_OK;
+}
