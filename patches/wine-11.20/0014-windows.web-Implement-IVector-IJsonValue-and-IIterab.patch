+DEFINE_IINSPECTABLE( iterable, IIterable_IJsonValue, struct json_array, IJsonArray_iface )
+
+static HRESULT WINAPI iterable_First( IIterable_IJsonValue *iface, IIterator_IJsonValue **value )
