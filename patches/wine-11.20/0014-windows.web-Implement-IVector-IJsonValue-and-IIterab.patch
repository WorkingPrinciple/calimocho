+    /* IVector<IJsonValue> methods */
+    vector_GetAt,
+    vector_get_Size,
+    vector_GetView,
+    vector_IndexOf,
+    vector_SetAt,
+    vector_InsertAt,
+    vector_RemoveAt,
+    vector_Append,
+    vector_RemoveAtEnd,
+    vector_Clear,
+    vector_GetMany,
+    vector_ReplaceAll,
+};
