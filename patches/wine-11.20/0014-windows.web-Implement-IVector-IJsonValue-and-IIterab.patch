+static HRESULT WINAPI vector_GetView( IVector_IJsonValue *iface, IVectorView_IJsonValue **value )
+{
+    struct json_array *impl = impl_from_IVector_IJsonValue( iface );
+    struct json_array_view *view;
+
+    TRACE( "iface %p, value %p.\n", iface, value );
+
+    if (!value) return E_POINTER;
+    if (!(view = calloc( 1, sizeof(*view) ))) return E_OUTOFMEMORY;
+    view->IVectorView_IJsonValue_iface.lpVtbl = &view_vtbl;
+    view->IIterable_IJsonValue_iface.lpVtbl = &view_iterable_vtbl;
+    view->ref = 1;
+    view->array = impl;
+    IJsonArray_AddRef( &impl->IJsonArray_iface );
+    *value = &view->IVectorView_IJsonValue_iface;
+    return S_OK;
+}
+
+static HRESULT WINAPI vector_IndexOf( IVector_IJsonValue *iface, IJsonValue *element, UINT32 *index,
+                                      BOOLEAN *found )
+{
+    struct json_array *impl = impl_from_IVector_IJsonValue( iface );
+    TRACE( "iface %p, element %p, index %p, found %p.\n", iface, element, index, found );
+    return json_array_index_of( impl, element, index, found );
+}
+
+static HRESULT WINAPI vector_SetAt( IVector_IJsonValue *iface, UINT32 index, IJsonValue *value )
+{
+    struct json_array *impl = impl_from_IVector_IJsonValue( iface );
+
+    TRACE( "iface %p, index %u, value %p.\n", iface, index, value );
+
+    if (!value) return E_POINTER;
+    if (index >= impl->length) return E_BOUNDS;
+    IJsonValue_AddRef( value );
+    IJsonValue_Release( impl->elements[index] );
+    impl->elements[index] = value;
+    return S_OK;
+}
+
+static HRESULT WINAPI vector_InsertAt( IVector_IJsonValue *iface, UINT32 index, IJsonValue *value )
+{
+    struct json_array *impl = impl_from_IVector_IJsonValue( iface );
+    HRESULT hr;
+
+    TRACE( "iface %p, index %u, value %p.\n", iface, index, value );
+
+    if (!value) return E_POINTER;
+    if (index > impl->length) return E_BOUNDS;
+    if (FAILED(hr = json_array_reserve( impl, impl->length + 1 ))) return hr;
+    memmove( impl->elements + index + 1, impl->elements + index,
+             (impl->length - index) * sizeof(*impl->elements) );
+    IJsonValue_AddRef( (impl->elements[index] = value) );
+    impl->length++;
+    return S_OK;
+}
+
+static HRESULT WINAPI vector_RemoveAt( IVector_IJsonValue *iface, UINT32 index )
+{
+    struct json_array *impl = impl_from_IVector_IJsonValue( iface );
+
+    TRACE( "iface %p, index %u.\n", iface, index );
+
+    if (index >= impl->length) return E_BOUNDS;
+    IJsonValue_Release( impl->elements[index] );
+    memmove( impl->elements + index, impl->elements + index + 1,
+             (impl->length - index - 1) * sizeof(*impl->elements) );
+    impl->length--;
+    return S_OK;
+}
+
+static HRESULT WINAPI vector_Append( IVector_IJsonValue *iface, IJsonValue *value )
+{
+    struct json_array *impl = impl_from_IVector_IJsonValue( iface );
+    TRACE( "iface %p, value %p.\n", iface, value );
+    if (!value) return E_POINTER;
+    return json_array_push( &impl->IJsonArray_iface, value );
+}
+
+static HRESULT WINAPI vector_RemoveAtEnd( IVector_IJsonValue *iface )
+{
+    struct json_array *impl = impl_from_IVector_IJsonValue( iface );
+
+    TRACE( "iface %p.\n", iface );
+
+    if (!impl->length) return E_BOUNDS;
+    IJsonValue_Release( impl->elements[--impl->length] );
+    return S_OK;
+}
+
+static HRESULT WINAPI vector_Clear( IVector_IJsonValue *iface )
+{
+    struct json_array *impl = impl_from_IVector_IJsonValue( iface );
+
+    TRACE( "iface %p.\n", iface );
+
+    while (impl->length) IJsonValue_Release( impl->elements[--impl->length] );
+    return S_OK;
+}
+
+static HRESULT WINAPI vector_GetMany( IVector_IJsonValue *iface, UINT32 start, UINT32 size,
+                                      IJsonValue **items, UINT *count )
+{
+    struct json_array *impl = impl_from_IVector_IJsonValue( iface );
+    TRACE( "iface %p, start %u, size %u, items %p, count %p.\n", iface, start, size, items, count );
+    return json_array_get_many( impl, start, size, items, count );
+}
+
+static HRESULT WINAPI vector_ReplaceAll( IVector_IJsonValue *iface, UINT32 count, IJsonValue **items )
+{
+    struct json_array *impl = impl_from_IVector_IJsonValue( iface );
+    HRESULT hr;
+    UINT32 i;
+
+    TRACE( "iface %p, count %u, items %p.\n", iface, count, items );
+
+    if (count && !items) return E_POINTER;
+    for (i = 0; i < count; i++) if (!items[i]) return E_POINTER;
+    if (FAILED(hr = json_array_reserve( impl, count ))) return hr;
+    for (i = 0; i < count; i++) IJsonValue_AddRef( items[i] );
+    while (impl->length) IJsonValue_Release( impl->elements[--impl->length] );
+    memcpy( impl->elements, items, count * sizeof(*items) );
+    impl->length = count;
+    return S_OK;
+}
