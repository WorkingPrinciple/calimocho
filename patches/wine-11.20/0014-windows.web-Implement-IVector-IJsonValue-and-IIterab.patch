+/* Windows.Data.Json.JsonArray also implements IVector<IJsonValue> and IIterable<IJsonValue>.
+ * The view and the iterators are live: they keep the array alive and read its current
+ * contents, as on Windows. */
+
+static HRESULT json_array_get_at( struct json_array *impl, UINT32 index, IJsonValue **value )
+{
+    if (!value) return E_POINTER;
+    if (index >= impl->length) return E_BOUNDS;
+    IJsonValue_AddRef( (*value = impl->elements[index]) );
+    return S_OK;
+}
+
+static HRESULT json_array_index_of( struct json_array *impl, IJsonValue *element, UINT32 *index,
+                                    BOOLEAN *found )
+{
+    if (!index || !found) return E_POINTER;
+    for (*index = 0; *index < impl->length; (*index)++)
+    {
+        if (impl->elements[*index] != element) continue;
+        *found = TRUE;
+        return S_OK;
+    }
+    *index = 0;
+    *found = FALSE;
+    return S_OK;
+}
+
+static HRESULT json_array_get_many( struct json_array *impl, UINT32 start, UINT32 size,
+                                    IJsonValue **items, UINT *count )
+{
+    UINT32 i;
+
+    if (!count || (size && !items)) return E_POINTER;
+    if (start > impl->length) return E_BOUNDS;
+    for (i = 0; i < size && start + i < impl->length; i++)
+        IJsonValue_AddRef( (items[i] = impl->elements[start + i]) );
+    *count = i;
+    return S_OK;
+}
+
+struct json_array_iterator
+{
+    IIterator_IJsonValue IIterator_IJsonValue_iface;
+    LONG ref;
+    struct json_array *array;
+    UINT32 index;
+};
+
+static inline struct json_array_iterator *impl_from_IIterator_IJsonValue( IIterator_IJsonValue *iface )
+{
+    return CONTAINING_RECORD( iface, struct json_array_iterator, IIterator_IJsonValue_iface );
+}
+
+static HRESULT WINAPI iterator_QueryInterface( IIterator_IJsonValue *iface, REFIID iid, void **out )
+{
+    struct json_array_iterator *impl = impl_from_IIterator_IJsonValue( iface );
+
+    TRACE( "iface %p, iid %s, out %p.\n", iface, debugstr_guid( iid ), out );
+
+    if (IsEqualGUID( iid, &IID_IUnknown ) ||
+        IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) ||
+        IsEqualGUID( iid, &IID_IIterator_IJsonValue ))
+    {
+        IInspectable_AddRef( (*out = &impl->IIterator_IJsonValue_iface) );
+        return S_OK;
+    }
+
+    FIXME( "%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid( iid ) );
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI iterator_AddRef( IIterator_IJsonValue *iface )
+{
+    struct json_array_iterator *impl = impl_from_IIterator_IJsonValue( iface );
+    ULONG ref = InterlockedIncrement( &impl->ref );
+    TRACE( "iface %p, ref %lu.\n", iface, ref );
+    return ref;
+}
+
+static ULONG WINAPI iterator_Release( IIterator_IJsonValue *iface )
+{
+    struct json_array_iterator *impl = impl_from_IIterator_IJsonValue( iface );
+    ULONG ref = InterlockedDecrement( &impl->ref );
+
+    TRACE( "iface %p, ref %lu.\n", iface, ref );
+
+    if (!ref)
+    {
+        IJsonArray_Release( &impl->array->IJsonArray_iface );
+        free( impl );
+    }
+    return ref;
+}
+
+static HRESULT WINAPI iterator_GetIids( IIterator_IJsonValue *iface, ULONG *iid_count, IID **iids )
+{
+    FIXME( "iface %p, iid_count %p, iids %p stub!\n", iface, iid_count, iids );
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI iterator_GetRuntimeClassName( IIterator_IJsonValue *iface, HSTRING *class_name )
+{
+    FIXME( "iface %p, class_name %p stub!\n", iface, class_name );
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI iterator_GetTrustLevel( IIterator_IJsonValue *iface, TrustLevel *trust_level )
+{
+    FIXME( "iface %p, trust_level %p stub!\n", iface, trust_level );
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI iterator_get_Current( IIterator_IJsonValue *iface, IJsonValue **value )
+{
+    struct json_array_iterator *impl = impl_from_IIterator_IJsonValue( iface );
+    TRACE( "iface %p, value %p.\n", iface, value );
+    return json_array_get_at( impl->array, impl->index, value );
+}
+
+static HRESULT WINAPI iterator_get_HasCurrent( IIterator_IJsonValue *iface, boolean *value )
+{
+    struct json_array_iterator *impl = impl_from_IIterator_IJsonValue( iface );
+
+    TRACE( "iface %p, value %p.\n", iface, value );
+
+    if (!value) return E_POINTER;
+    *value = impl->index < impl->array->length;
+    return S_OK;
+}
+
+static HRESULT WINAPI iterator_MoveNext( IIterator_IJsonValue *iface, boolean *value )
+{
+    struct json_array_iterator *impl = impl_from_IIterator_IJsonValue( iface );
+
+    TRACE( "iface %p, value %p.\n", iface, value );
+
+    if (!value) return E_POINTER;
+    if (impl->index < impl->array->length) impl->index++;
+    *value = impl->index < impl->array->length;
+    return S_OK;
+}
+
+static HRESULT WINAPI iterator_GetMany( IIterator_IJsonValue *iface, UINT32 size, IJsonValue **items,
+                                        UINT *count )
+{
+    struct json_array_iterator *impl = impl_from_IIterator_IJsonValue( iface );
+    HRESULT hr;
+
+    TRACE( "iface %p, size %u, items %p, count %p.\n", iface, size, items, count );
+
+    if (impl->index >= impl->array->length)
+    {
+        if (!count) return E_POINTER;
+        *count = 0;
+        return S_OK;
+    }
+    if (SUCCEEDED(hr = json_array_get_many( impl->array, impl->index, size, items, count )))
+        impl->index += *count;
+    return hr;
+}
+
+static const struct IIterator_IJsonValueVtbl iterator_vtbl =
+{
+    iterator_QueryInterface,
+    iterator_AddRef,
+    iterator_Release,
+    /* IInspectable methods */
+    iterator_GetIids,
+    iterator_GetRuntimeClassName,
+    iterator_GetTrustLevel,
+    /* IIterator<IJsonValue> methods */
+    iterator_get_Current,
+    iterator_get_HasCurrent,
+    iterator_MoveNext,
+    iterator_GetMany,
+};
+
+static HRESULT json_array_first( struct json_array *impl, IIterator_IJsonValue **value )
+{
+    struct json_array_iterator *iter;
+
+    if (!value) return E_POINTER;
+    if (!(iter = calloc( 1, sizeof(*iter) ))) return E_OUTOFMEMORY;
+    iter->IIterator_IJsonValue_iface.lpVtbl = &iterator_vtbl;
+    iter->ref = 1;
+    iter->array = impl;
+    IJsonArray_AddRef( &impl->IJsonArray_iface );
+    *value = &iter->IIterator_IJsonValue_iface;
+    return S_OK;
+}
