From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dragos Hont <dragos79@gmail.com>
Date: Mon, 26 Oct 2026 10:30:00 +0200
Subject: [PATCH 15/15] winebus.sys: Normalize the Xbox One S Bluetooth LE input
 descriptor on IOHID

The Xbox controller 045e:0b20 over Bluetooth LE reports its right stick
as Z/Rz, its triggers as Simulation Brake/Accelerator and its buttons as
sparse numbers 1,2,4,5,7,8,11,12,14,15. Wine assumes Rx/Ry sticks, Z/Rz
triggers and buttons 1-10, so the right stick drove the triggers and the
right trigger pressed a button.

For this device on Bluetooth, and only when the descriptor matches the
observed one byte for byte, rewrite the input usages to the layout Wine
expects without moving any report field, keep the output reports, invert
Y to the convention the SDL backend uses, and map Consumer AC Back to
View as SDL does for this firmware. Other descriptors are left unchanged
with a warning. Tests: tests/wine/test_xbox_ble_mapping.py.
---
  dlls/winebus.sys/bus_iohid.c |  101 ++++++++++++++++++++++++++++++++++++++++++
  1 file changed, 100 insertions(+), 1 deletion(-)

--- a/dlls/winebus.sys/bus_iohid.c
+++ b/dlls/winebus.sys/bus_iohid.c
@@ -136,6 +136,8 @@
     struct unix_device unix_device;
     IOHIDDeviceRef device;
     uint8_t *buffer;
+    BOOL xbox_ble;
+    BOOL xbox_ble_mapped;
 };
 
 static inline struct iohid_device *impl_from_unix_device(struct unix_device *iface)
@@ -173,6 +175,26 @@
         uint32_t reportID, uint8_t *report, CFIndex report_length)
 {
     struct unix_device *iface = (struct unix_device *)context;
+    struct iohid_device *impl = impl_from_unix_device(iface);
+    BYTE normalized[17];
+
+    if (impl->xbox_ble_mapped && reportID == 1)
+    {
+        if (report_length != sizeof(normalized) || report[0] != 1)
+        {
+            WARN("Unexpected Xbox BLE input report length %ld or ID %u\n", report_length, reportID);
+            return;
+        }
+        memcpy(normalized, report, sizeof(normalized));
+        /* Match the XUSB/GIP up-positive Y convention, as the SDL backend does. */
+        normalized[3] ^= 0xff;
+        normalized[4] ^= 0xff;
+        normalized[7] ^= 0xff;
+        normalized[8] ^= 0xff;
+        /* Some firmware sends View through Consumer AC Back instead of button 11. */
+        if (normalized[16] & 0x01) normalized[15] |= 0x04;
+        report = normalized;
+    }
     bus_event_queue_input_report(&event_queue, iface, report, report_length);
 }
 
@@ -205,6 +227,78 @@
     pthread_mutex_unlock(&iohid_cs);
 }
 
+static NTSTATUS xbox_ble_get_report_descriptor(const BYTE *data, UINT size, BYTE *buffer,
+                                               UINT length, UINT *out_length, BOOL *normalized)
+{
+    /* Xbox One S BLE uses Z/Rz for the right stick, Simulation controls for
+     * triggers, and sparse button numbers. Normalize the observed input layout
+     * once, so XInput and DirectInput/WGI agree without moving report fields. */
+    static const BYTE original[] =
+    {
+        0x05,0x01,0x09,0x05,0xa1,0x01,0x85,0x01,0x09,0x01,0xa1,0x00,
+        0x09,0x30,0x09,0x31,0x15,0x00,0x27,0xff,0xff,0x00,0x00,
+        0x95,0x02,0x75,0x10,0x81,0x02,0xc0,0x09,0x01,0xa1,0x00,
+        0x09,0x32,0x09,0x35,0x15,0x00,0x27,0xff,0xff,0x00,0x00,
+        0x95,0x02,0x75,0x10,0x81,0x02,0xc0,
+        0x05,0x02,0x09,0xc5,0x15,0x00,0x26,0xff,0x03,0x95,0x01,0x75,0x0a,0x81,0x02,
+        0x15,0x00,0x25,0x00,0x75,0x06,0x95,0x01,0x81,0x03,
+        0x05,0x02,0x09,0xc4,0x15,0x00,0x26,0xff,0x03,0x95,0x01,0x75,0x0a,0x81,0x02,
+        0x15,0x00,0x25,0x00,0x75,0x06,0x95,0x01,0x81,0x03,
+        0x05,0x01,0x09,0x39,0x15,0x01,0x25,0x08,0x35,0x00,0x46,0x3b,0x01,
+        0x66,0x14,0x00,0x75,0x04,0x95,0x01,0x81,0x42,
+        0x75,0x04,0x95,0x01,0x15,0x00,0x25,0x00,0x35,0x00,0x45,0x00,0x65,0x00,0x81,0x03,
+        0x05,0x09,0x19,0x01,0x29,0x0f,0x15,0x00,0x25,0x01,0x75,0x01,0x95,0x0f,0x81,0x02,
+        0x15,0x00,0x25,0x00,0x75,0x01,0x95,0x01,0x81,0x03,
+        0x05,0x0c,0x0a,0xb2,0x00,0x15,0x00,0x25,0x01,0x95,0x01,0x75,0x01,0x81,0x02,
+        0x15,0x00,0x25,0x00,0x75,0x07,0x95,0x01,0x81,0x03,
+    };
+    static const BYTE mapped[] =
+    {
+        0x05,0x01,0x09,0x05,0xa1,0x01,0x85,0x01,0x09,0x01,0xa1,0x00,
+        0x09,0x30,0x09,0x31,0x15,0x00,0x27,0xff,0xff,0x00,0x00,
+        0x95,0x02,0x75,0x10,0x81,0x02,0xc0,0x09,0x01,0xa1,0x00,
+        0x09,0x33,0x09,0x34,0x15,0x00,0x27,0xff,0xff,0x00,0x00,
+        0x95,0x02,0x75,0x10,0x81,0x02,0xc0,
+        0x05,0x01,0x09,0x32,0x15,0x00,0x26,0xff,0x03,0x95,0x01,0x75,0x0a,0x81,0x02,
+        0x15,0x00,0x25,0x00,0x75,0x06,0x95,0x01,0x81,0x03,
+        0x05,0x01,0x09,0x35,0x15,0x00,0x26,0xff,0x03,0x95,0x01,0x75,0x0a,0x81,0x02,
+        0x15,0x00,0x25,0x00,0x75,0x06,0x95,0x01,0x81,0x03,
+        0x05,0x01,0x09,0x39,0x15,0x01,0x25,0x08,0x35,0x00,0x46,0x3b,0x01,
+        0x66,0x14,0x00,0x75,0x04,0x95,0x01,0x81,0x42,
+        0x75,0x04,0x95,0x01,0x15,0x00,0x25,0x00,0x35,0x00,0x45,0x00,0x65,0x00,0x81,0x03,
+        0x05,0x09,0x15,0x00,0x25,0x01,0x75,0x01,
+        0x19,0x01,0x29,0x02,0x95,0x02,0x81,0x02, /* A, B */
+        0x95,0x01,0x81,0x03,
+        0x19,0x03,0x29,0x04,0x95,0x02,0x81,0x02, /* X, Y */
+        0x95,0x01,0x81,0x03,
+        0x19,0x05,0x29,0x06,0x95,0x02,0x81,0x02, /* LB, RB */
+        0x95,0x02,0x81,0x03,
+        0x19,0x07,0x29,0x08,0x95,0x02,0x81,0x02, /* View, Menu */
+        0x06,0x00,0xff,0x09,0x01,0x95,0x01,0x81,0x02, /* Guide */
+        0x05,0x09,0x19,0x09,0x29,0x0a,0x95,0x02,0x81,0x02, /* Stick clicks */
+        0x15,0x00,0x25,0x00,0x75,0x01,0x95,0x01,0x81,0x03,
+        0x05,0x0c,0x0a,0xb2,0x00,0x15,0x00,0x25,0x01,0x95,0x01,0x75,0x01,0x81,0x02,
+        0x15,0x00,0x25,0x00,0x75,0x07,0x95,0x01,0x81,0x03,
+    };
+
+    *normalized = FALSE;
+    if (size < sizeof(original) || memcmp(data, original, sizeof(original)))
+    {
+        WARN("Unrecognized Xbox 045e:0b20 BLE input descriptor, leaving mapping unchanged\n");
+        *out_length = size;
+        if (length < size) return STATUS_BUFFER_TOO_SMALL;
+        memcpy(buffer, data, size);
+        return STATUS_SUCCESS;
+    }
+
+    *normalized = TRUE;
+    *out_length = size - sizeof(original) + sizeof(mapped);
+    if (length < *out_length) return STATUS_BUFFER_TOO_SMALL;
+    memcpy(buffer, mapped, sizeof(mapped));
+    memcpy(buffer + sizeof(mapped), data + sizeof(original), size - sizeof(original));
+    return STATUS_SUCCESS;
+}
+
 static NTSTATUS iohid_device_get_report_descriptor(struct unix_device *iface, BYTE *buffer,
                                                    UINT length, UINT *out_length)
 {
@@ -213,11 +307,14 @@
     int data_length = CFDataGetLength(data);
     const UInt8 *ptr;
 
+    ptr = CFDataGetBytePtr(data);
+    if (impl->xbox_ble)
+        return xbox_ble_get_report_descriptor(ptr, data_length, buffer, length, out_length, &impl->xbox_ble_mapped);
+
     *out_length = data_length;
     if (length < data_length)
         return STATUS_BUFFER_TOO_SMALL;
 
-    ptr = CFDataGetBytePtr(data);
     memcpy(buffer, ptr, data_length);
     return STATUS_SUCCESS;
 }
@@ -449,6 +546,8 @@
     list_add_tail(&device_list, &impl->unix_device.entry);
     impl->device = IOHIDDevice;
     impl->buffer = NULL;
+    impl->xbox_ble = desc.vid == 0x045e && desc.pid == 0x0b20 && desc.bus_type == BUS_TYPE_BLUETOOTH;
+    impl->xbox_ble_mapped = FALSE;
 
     bus_event_queue_device_created(&event_queue, &impl->unix_device, &desc);
 }
