+static const MVKMTLBufferAllocation* getPushDescriptorSnapshot(MVKCommandEncoder& mvkEncoder,
+                                                               const MVKVulkanCommonEncoderState& common,
+                                                               const MVKDescriptorSetLayout* layout) {
+	if (!common._pushDescSnapshot || common._pushDescSnapshotOwner != mvkEncoder._mtlCmdBuffer) {
+		const MVKDescriptorSet& set = common._pushDescriptor;
