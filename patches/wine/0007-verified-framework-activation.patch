 #include "wine/debug.h"
 
 WINE_DEFAULT_DEBUG_CHANNEL(combase);
+WINE_DECLARE_DEBUG_CHANNEL(pkgactivate);
+
+static void trace_package_activation(const char *operation, HSTRING classid, REFIID iid, HRESULT hr)
+{
+    const WCHAR *name = WindowsGetStringRawBuffer(classid, NULL);
+    WCHAR key[640];
+    HKEY registration;
+    DWORD type, size = 0;
+    const char *server = "absent";
+    BOOL present = FALSE;
+    if (!TRACE_ON(pkgactivate)) return;
+    if (name && wcslen(name) < 512)
+    {
+        lstrcpyW(key, L"Software\\Microsoft\\WindowsRuntime\\ActivatableClassId\\");
+        lstrcatW(key, name);
+        if (!RegOpenKeyExW(HKEY_LOCAL_MACHINE, key, 0, KEY_READ, &registration))
+        {
+            present = TRUE;
+            server = "unknown";
+            if (!RegQueryValueExW(registration, L"DllPath", NULL, &type, NULL, &size)
+                && (type == REG_SZ || type == REG_EXPAND_SZ) && size > sizeof(WCHAR))
+                server = "in-process-dll";
+            else if (!RegQueryValueExW(registration, L"Server", NULL, &type, NULL, &size)
+                     && (type == REG_SZ || type == REG_EXPAND_SZ) && size > sizeof(WCHAR))
+                server = "out-of-process-server";
+            RegCloseKey(registration);
+        }
+    }
+    TRACE_(pkgactivate)("operation=%s class=%s iid=%s hr=%08lx registration=%u server=%s\n",
+                              operation, debugstr_hstring(classid), debugstr_guid(iid),
+                              hr, present, server);
+}
 
