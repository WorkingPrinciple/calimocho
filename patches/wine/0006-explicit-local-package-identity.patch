+        fatal_error( "Invalid host package registration contents\n" );
+    for (i = 0; package_registration.image[i]; ++i) {}
+    package_registration_image_size = i * sizeof(WCHAR);
+    unsetenv( "CALIMOCHO_PACKAGE_REGISTRATION" );
