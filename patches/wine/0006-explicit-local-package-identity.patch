+/*
+ * Local activation context for generated diagnostic replacements.
+ * Copyright 2026 Calimocho contributors
+ * SPDX-License-Identifier: LGPL-2.1-or-later
+ *
+ * The including translation unit must provide a Wine debug channel.
+ */
+#ifndef __WINE_WHINY_CONTEXT_H
+#define __WINE_WHINY_CONTEXT_H
+#include <string.h>
+#include "wine/package.h"
+
+static int whiny_context_active(const char *name)
+{
+    struct wine_package_identity identity;
+    NTSTATUS status = wine_query_package_identity((HANDLE)(LONG_PTR)-4, &identity);
+
+    if (status != STATUS_SUCCESS && status != STATUS_NOT_FOUND)
+    {
+        ERR("Package activation metadata query failed %#lx\n", status);
+        return 0;
+    }
+    if (!strcmp(name, "packaged")) return status == STATUS_SUCCESS;
+    if (!strcmp(name, "unpackaged")) return status == STATUS_NOT_FOUND;
+    if (!strcmp(name, "packaged-gamingapp-signed"))
+    {
+        return status == STATUS_SUCCESS && identity.verified_gamingapp == 1
+            && !memcmp( identity.family_name, L"Microsoft.GamingApp_8wekyb3d8bbwe",
+                        sizeof(L"Microsoft.GamingApp_8wekyb3d8bbwe") );
+    }
+    ERR("Unknown generated package context %s\n", debugstr_a(name));
+    return 0;
+}
+#define WHINY_CONTEXT_ACTIVE(name) whiny_context_active(name)
+#endif
