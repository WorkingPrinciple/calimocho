          "dxgi.def": {
            "sha256": "e53ca0d796e1861bec850f618239af7b651131c34210faa3768c9229d38ed64a"
          },
          "umd_version.h": {
            "sha256": "e1cf95588a84303f3034b1e099a7221c35800e27c02b972d75815c8c71f1db2f"
          }
        },
        "compile": [
