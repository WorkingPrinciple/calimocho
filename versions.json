          "nvapi_version.h": {
            "sha256": "4508608c4033f96fbd814cd1162ffa422d441327a8b32032f5b483c215ba5691"
          }
        },
        "compile": [
          "nvapi64.c",
          "nvapi64.def"
        ],
        "link": [
          "kernel32",
          "advapi32"
        ],
        "install_path": "lib/calimocho/x86_64-windows/nvapi64.dll"
      },
      {
        "_doc": "Calimocho's own DXGI front-end (REQ-120, ADR-0084), LGPL-2.1+. Loads Apple's dxgi.dll unchanged and forwards every export; only IDXGIAdapter::CheckInterfaceSupport reports the display Class key DriverVersion instead of Apple's 65535.65535.65535.65535. Inert unless D3DM_VENDOR_ID is set. Only the FH6 profile uses it.",
        "name": "dxgi_umd",
        "source": "tools/dxgi_umd",
        "files": {
          "dxgi.c": {
            "sha256": "c59623069fb84866fd048d01ff6ace20e15fb31e62f061f39ed9cc583796323d"
