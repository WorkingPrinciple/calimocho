    "opt_ins": {
      "fh6": {
        "_doc": "Forza Horizon 6 only. Ode's FH6 title profile sets these; every other title leaves them unset, which keeps -01 behaviour.",
        "environment": {
          "CALIMOCHO_FIX_ROSETTA_WX": "1",
          "CALIMOCHO_FIX_ROSETTA_MXCSR": "1",
          "CALIMOCHO_FIX_FIBER_GS": "1",
          "CALIMOCHO_FIX_NX_ALWAYS": "1",
          "CALIMOCHO_FIX_THREADPOOL_IO": "1",
          "CALIMOCHO_FIX_ICON_REPLY": "1",
          "D3DM_VENDOR_ID": "0x10de",
          "D3DM_DEVICE_ID": "0x2786",
          "D3DM_DEVICE_DESCRIPTION": "NVIDIA GeForce RTX 4070",
          "D3DM_MTL4": "0",
          "XODUS_PRIVATE_LOCAL_SAVES": "1",
          "HB_D3D12_REAL": "Z:${ENGINE_ROOT_WINDOWS}\\lib\\wine\\x86_64-windows\\d3d12.dll"
        },
        "optional_environment": {
          "XODUS_MUTE_AUDIO": "1"
        },
        "profile_steps": [
          "After the prefix is created or updated for this engine, copy ${ENGINE_ROOT}/lib/wine/x86_64-windows/d3d12_tsshim.dll to <prefix>/drive_c/windows/system32/d3d12.dll.",
          "Set HB_D3D12_REAL to Z: + ${ENGINE_ROOT}/lib/wine/x86_64-windows/d3d12.dll with backslashes.",
          "Keep XODUS_PRIVATE_RUNTIME_COM_STA unset (runtime COM must stay MTA)."
        ]
      }
    },
