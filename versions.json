    "native_shims": [
      {
        "_doc": "Calimocho's own NVAPI stub (REQ-120, ADR-0083), LGPL-2.1+, built from tools/nvapi_stub with mingw-w64 and no C runtime. Installed outside lib/wine so wineboot never puts it in a prefix. Only the FH6 profile uses it, by copying it to drive_c/windows/system32/nvapi64.dll. It reports the same driver version as patch 0012 and returns NVAPI_NVIDIA_DEVICE_NOT_FOUND unless D3DM_VENDOR_ID is 0x10de.",
        "name": "nvapi_stub",
        "source": "tools/nvapi_stub",
        "files": {
