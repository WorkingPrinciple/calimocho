{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/WorkingPrinciple/calimocho/blob/main/docs/contracts/calimocho-engine-index-state-v1.schema.json",
  "title": "Calimocho engine index client state, version 1",
  "description": "What X Ode persists after an index passes every check (ADR-0082): the high-water mark for the current epoch, the keyids that established it, and every engine revocation seen so far.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "epoch",
    "index_version",
    "payload_sha256",
    "keyids",
    "revoked_engines"
  ],
  "properties": {
    "schema": {
      "const": "calimocho-engine-index-state/1"
    },
    "epoch": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "index_version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "payload_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "keyids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "$ref": "#/$defs/sha256"
      }
    },
    "revoked_engines": {
      "$ref": "#/$defs/revoked"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "revoked": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "engine_id",
          "reason"
        ],
        "properties": {
          "engine_id": {
            "type": "string",
            "pattern": "^calimocho-[0-9]+\\.[0-9]+-[0-9A-Za-z.]+-[0-9]{2,}$"
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500,
            "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
          }
        }
      }
    }
  }
}
