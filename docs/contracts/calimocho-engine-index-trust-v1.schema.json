{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/WorkingPrinciple/calimocho/blob/main/docs/contracts/calimocho-engine-index-trust-v1.schema.json",
  "title": "Calimocho engine index trust anchors, version 1",
  "description": "Embedded in X Ode and the backend at build time (ADR-0082).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "keys",
    "revoked_keyids",
    "floor",
    "revoked_engines"
  ],
  "properties": {
    "schema": {
      "const": "calimocho-engine-index-trust/1"
    },
    "description": {
      "type": "string",
      "maxLength": 2000,
      "pattern": "^[^\\u0000-\\u001f\\u007f]*$"
    },
    "keys": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "keyid",
          "public_key",
          "epoch",
          "status",
          "created"
        ],
        "properties": {
          "keyid": {
            "$ref": "#/$defs/sha256"
          },
          "public_key": {
            "description": "Standard base64 of the raw 32-byte Ed25519 public key.",
            "type": "string",
            "pattern": "^[A-Za-z0-9+/]{43}=$"
          },
          "epoch": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "status": {
            "enum": [
              "active",
              "retired"
            ]
          },
          "created": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          },
          "note": {
            "type": "string",
            "maxLength": 500,
            "pattern": "^[^\\u0000-\\u001f\\u007f]*$"
          }
        }
      }
    },
    "revoked_keyids": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/sha256"
      }
    },
    "floor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "epoch",
        "index_version"
      ],
      "properties": {
        "epoch": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "index_version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        }
      }
    },
    "revoked_engines": {
      "$ref": "#/$defs/revoked"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "revoked": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "engine_id",
          "reason"
        ],
        "properties": {
          "engine_id": {
            "type": "string",
            "pattern": "^calimocho-[0-9]+\\.[0-9]+-[0-9A-Za-z.]+-[0-9]{2,}$"
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500,
            "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
          }
        }
      }
    }
  }
}
