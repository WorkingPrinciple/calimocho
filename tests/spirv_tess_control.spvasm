; REQ-104: minimal tessellation control stage for the vertex output fixture.
; Output = 2 * tile - position. It equals position only when both vertex
; output block members were stored correctly. Independent fixture, not game source.
OpCapability Tessellation
OpMemoryModel Logical GLSL450
OpEntryPoint TessellationControl %main "main" %inputs %outputs %invocation %outer %inner
OpExecutionMode %main OutputVertices 3
OpName %inputs "In"
OpName %InBlock "VertexBlock"
OpMemberName %InBlock 0 "position"
OpMemberName %InBlock 1 "tile"
OpName %outputs "position"
OpDecorate %InBlock Block
OpMemberDecorate %InBlock 0 Location 0
OpMemberDecorate %InBlock 1 Location 1
OpDecorate %outputs Location 0
OpDecorate %invocation BuiltIn InvocationId
OpDecorate %outer BuiltIn TessLevelOuter
OpDecorate %outer Patch
OpDecorate %inner BuiltIn TessLevelInner
OpDecorate %inner Patch
%void = OpTypeVoid
%function = OpTypeFunction %void
%float = OpTypeFloat 32
%int = OpTypeInt 32 1
%uint = OpTypeInt 32 0
%vec4 = OpTypeVector %float 4
%i0 = OpConstant %int 0
%i1 = OpConstant %int 1
%i2 = OpConstant %int 2
%u2 = OpConstant %uint 2
%u3 = OpConstant %uint 3
%u4 = OpConstant %uint 4
%u32 = OpConstant %uint 32
%f1 = OpConstant %float 1
%f2 = OpConstant %float 2
%InBlock = OpTypeStruct %vec4 %vec4
%InArray = OpTypeArray %InBlock %u32
%input_ptr = OpTypePointer Input %InArray
%inputs = OpVariable %input_ptr Input
%OutArray = OpTypeArray %vec4 %u3
%output_ptr = OpTypePointer Output %OutArray
%outputs = OpVariable %output_ptr Output
%int_input_ptr = OpTypePointer Input %int
%invocation = OpVariable %int_input_ptr Input
%Outer = OpTypeArray %float %u4
%Inner = OpTypeArray %float %u2
%outer_ptr = OpTypePointer Output %Outer
%inner_ptr = OpTypePointer Output %Inner
%outer = OpVariable %outer_ptr Output
%inner = OpVariable %inner_ptr Output
%vec4_input_ptr = OpTypePointer Input %vec4
%vec4_output_ptr = OpTypePointer Output %vec4
%float_output_ptr = OpTypePointer Output %float
%main = OpFunction %void None %function
%entry = OpLabel
%id = OpLoad %int %invocation
%position_ptr = OpAccessChain %vec4_input_ptr %inputs %id %i0
%position = OpLoad %vec4 %position_ptr
%tile_ptr = OpAccessChain %vec4_input_ptr %inputs %id %i1
%tile = OpLoad %vec4 %tile_ptr
%double_tile = OpVectorTimesScalar %vec4 %tile %f2
%result = OpFSub %vec4 %double_tile %position
%result_ptr = OpAccessChain %vec4_output_ptr %outputs %id
OpStore %result_ptr %result
%outer0 = OpAccessChain %float_output_ptr %outer %i0
OpStore %outer0 %f1
%outer1 = OpAccessChain %float_output_ptr %outer %i1
OpStore %outer1 %f1
%outer2 = OpAccessChain %float_output_ptr %outer %i2
OpStore %outer2 %f1
%inner0 = OpAccessChain %float_output_ptr %inner %i0
OpStore %inner0 %f1
OpReturn
OpFunctionEnd
