; REQ-104: component stores to a vertex output block must retain thread storage
; when the vertex stage is lowered to a compute kernel for tessellation.
; Independent minimal reproduction of SPIRV-Cross PR 2719, not game source.
OpCapability Shader
OpMemoryModel Logical GLSL450
OpEntryPoint Vertex %main "main" %input %output %builtin
OpName %input "position"
OpName %output "Out"
OpName %Block "VertexBlock"
OpMemberName %Block 0 "position"
OpMemberName %Block 1 "tile"
OpName %PerVertex "gl_PerVertex"
OpMemberName %PerVertex 0 "gl_Position"
OpDecorate %input Location 0
OpDecorate %Block Block
OpMemberDecorate %Block 0 Location 0
OpMemberDecorate %Block 1 Location 1
OpDecorate %PerVertex Block
OpMemberDecorate %PerVertex 0 BuiltIn Position
%void = OpTypeVoid
%function = OpTypeFunction %void
%float = OpTypeFloat 32
%uint = OpTypeInt 32 0
%zero = OpConstant %uint 0
%one = OpConstant %uint 1
%two = OpConstant %uint 2
%three = OpConstant %uint 3
%vec4 = OpTypeVector %float 4
%Block = OpTypeStruct %vec4 %vec4
%PerVertex = OpTypeStruct %vec4
%input_ptr = OpTypePointer Input %vec4
%output_ptr = OpTypePointer Output %Block
%builtin_ptr = OpTypePointer Output %PerVertex
%scalar_ptr = OpTypePointer Output %float
%vector_ptr = OpTypePointer Output %vec4
%input = OpVariable %input_ptr Input
%output = OpVariable %output_ptr Output
%builtin = OpVariable %builtin_ptr Output
%main = OpFunction %void None %function
%entry = OpLabel
%value = OpLoad %vec4 %input
%x = OpCompositeExtract %float %value 0
%y = OpCompositeExtract %float %value 1
%z = OpCompositeExtract %float %value 2
%w = OpCompositeExtract %float %value 3
%px = OpAccessChain %scalar_ptr %output %zero %zero
OpStore %px %x
%py = OpAccessChain %scalar_ptr %output %zero %one
OpStore %py %y
%pz = OpAccessChain %scalar_ptr %output %zero %two
OpStore %pz %z
%pw = OpAccessChain %scalar_ptr %output %zero %three
OpStore %pw %w
%tx = OpAccessChain %scalar_ptr %output %one %zero
OpStore %tx %x
%ty = OpAccessChain %scalar_ptr %output %one %one
OpStore %ty %y
%tz = OpAccessChain %scalar_ptr %output %one %two
OpStore %tz %z
%tw = OpAccessChain %scalar_ptr %output %one %three
OpStore %tw %w
%position_ptr = OpAccessChain %vector_ptr %builtin %zero
OpStore %position_ptr %value
OpReturn
OpFunctionEnd
